{
	"name": "scrutiny-session-explorer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"better-sqlite3"
		]
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
