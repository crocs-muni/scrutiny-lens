{
  "name": "scrutiny-lens",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('build/index.html','build/404.html')\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "smoke:parse": "vitest run tests/smoke-parse.test.ts",
    "smoke": "vite dev --open /smoke"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@noble/hashes": "^2.0.1",
    "@scrutiny-fabric/core": "file:../scrutiny-fabric-tools/packages/core",
    "@tabler/icons-svelte": "^3.46.0",
    "@xyflow/svelte": "^1.6.5",
    "ai": "^7.0.79",
    "beautiful-ui-svelte": "file:../scrutiny-design-system",
    "bits-ui": "^2.19.0",
    "flexsearch": "^0.8.212",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^3.18.0",
    "marked": "^18.0.11",
    "nostr-tools": "^2.25.0",
    "shadow-plugin": "^2.1.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
