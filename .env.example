# Required: e-INFRA API key (https://chat.ai.e-infra.cz → Account → API keys)
API_KEY=

# Optional: override the LLM gateway (default is e-INFRA)
BASE_URL=https://llm.ai.e-infra.cz/v1

# Optional: override the default model (default is "coder", alias for qwen3.5-122b)
MODEL=coder

# Public relay URL used by the browser
PUBLIC_RELAY_URL=ws://localhost:7777
