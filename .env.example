# Comma-separated 1-4 default Nostr relay URLs the browser connects to.
# The user can edit the pool in Settings; these are only the first-run defaults.
# Falls back to the built-in pool when unset (lens-demo test-corpus home,
# then Primal's free public mirror — see SPEC_RELAYS in src/lib/config.ts).
PUBLIC_RELAY_URLS=wss://lens-demo.feeds.relay.tools,wss://relay.primal.net/

# SCRUTINY Fabric test corpora (jcalgtest / sec-certs bootstrap 2026-09-16):
# when truthy ('1'/'true'/'yes') the fabric seam treats the full-mirror
# `scrutiny-*-test` t-tag namespace as first-class (admission normalizes the
# test tags, relay filters span both namespaces). Default ON when unset.
# Set to 0 or false to quarantine the test corpora again.
# PUBLIC_INCLUDE_TEST_TAGS=1

# SCRUTINY Fabric test corpora (jcalgtest / sec-certs bootstrap 2026-09-16):
# when truthy ('1'/'true'/'yes') the fabric seam treats the full-mirror
# `scrutiny-*-test` t-tag namespace as first-class (admission normalizes the
# test tags, relay filters span both namespaces). Default ON when unset.
# Set to 0 or false to quarantine the test corpora again.
# PUBLIC_INCLUDE_TEST_TAGS=1

# Default OpenAI-compatible AI endpoint for Settings. Optional — falls back to
# the spec §5 default (https://llm.fi.muni.cz/v1) when unset.
# PUBLIC_LLM_ENDPOINT=https://llm.fi.muni.cz/v1

# The API key is never configured here: the user types it into Settings, where
# it lives in memory for the open tab only (spec §6).
