# Required for interpretation; the app degrades gracefully without it.
API_KEY=

# OpenAI-compatible endpoint.
BASE_URL=https://llm.ai.e-infra.cz/v1

# Default model identifier.
MODEL=coder

# Comma-separated 1-4 Nostr relay URLs the browser connects to.
PUBLIC_RELAY_URLS=ws://localhost:8080/ws

# Browser BYOK (ADR-018): clients may pass a provider override per request
# (baseUrl/model/apiKey). Override keys are NEVER persisted or logged server-side.
